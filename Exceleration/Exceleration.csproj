<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Reads .xlsx, .xlsm, .xlsb and .xls workbooks into memory through ExcelDataReader and addresses their cells by sheet name, A1 reference, or row and column number, with typed conversion of cell values. Reads only; does not write workbooks.</Description>
		<Authors>WilliamSmithE</Authors>
		<PackageReadmeFile>nugetREADME.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/WilliamSmithEdward/Exceleration</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/WilliamSmithEdward/Exceleration</PackageProjectUrl>
		<PackageTags>excel;exceldatareader;xlsx;xls;xlsb;workbook;worksheet;spreadsheet;cell;reader</PackageTags>
		<AssemblyVersion>1.1.1.4</AssemblyVersion>
		<PackageVersion>1.1.1.4</PackageVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>Exceleration.png</PackageIcon>
		<Copyright>William Edward Smith, 2023</Copyright>
		<Title>Exceleration</Title>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="ExcelDataReader" Version="3.9.0" />
	  <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="Exceleration.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="nugetREADME.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>